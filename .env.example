# ---------------------------------------------------------------------------
# Copy this file to ".env" (same folder) before starting the app:
#     cp .env.example .env
# The default values below work out of the box for local Docker use.
# Change JWT_SECRET (and the DB password) to your own random values.
# ---------------------------------------------------------------------------

# ----- Database (PostgreSQL) -----
POSTGRES_USER=trello
POSTGRES_PASSWORD=trello_local_password
POSTGRES_DB=trello

# Connection string the backend uses to reach the database.
# Host "db" is the service name inside Docker Compose.
DATABASE_URL=postgresql://trello:trello_local_password@db:5432/trello?schema=public

# ----- Backend API -----
# Port the API listens on inside its container.
PORT=4000

# Secret used to sign login tokens. MUST be changed to a long random string.
# Generate one with:  openssl rand -hex 32
JWT_SECRET=change_me_to_a_long_random_string_at_least_32_chars

# How long a login stays valid.
JWT_EXPIRES_IN=7d

# Send the login cookie only over HTTPS. Keep "false" for local Docker
# (which serves plain HTTP on localhost); set "true" for a real HTTPS deploy.
COOKIE_SECURE=false

# Environment mode: "development" or "production"
NODE_ENV=production

# Where the frontend is served from (used for CORS + secure cookie settings).
CLIENT_ORIGIN=http://localhost:8080

# ----- Seed data -----
# A demo account is created on first start so you can log in immediately.
SEED_DEMO_EMAIL=demo@example.com
SEED_DEMO_PASSWORD=demo1234

# ----- Frontend -----
# Port you open in your browser.
WEB_PORT=8080
